#include <stdio.h>

int main() {
    int a[2][3], b[2][3], c[2][3];
    int i, j, choice;

    printf("Enter first matrix elements:\n");
    for(i = 0; i < 2; i++) {
        for(j = 0; j < 3; j++) {
            scanf("%d", &a[i][j]);
        }
    }

    printf("Enter second matrix elements:\n");
    for(i = 0; i < 2; i++) {
        for(j = 0; j < 3; j++) {
            scanf("%d", &b[i][j]);
        }
    }

    printf("\n1. Addition");
    printf("\n2. Subtraction");
    printf("\nEnter choice: ");
    scanf("%d", &choice);

    if(choice == 1 || choice == 2) {
        for(i = 0; i < 2; i++) {
            for(j = 0; j < 3; j++) {
                if(choice == 1)
                    c[i][j] = a[i][j] + b[i][j];
                else
                    c[i][j] = a[i][j] - b[i][j];
            }
        }

        printf("\nResult matrix:\n");
        for(i = 0; i < 2; i++) {
            for(j = 0; j < 3; j++) {
                printf("%d ", c[i][j]);
            }
            printf("\n");
        }
    }
    else {
        printf("Invalid choice.");
    }

    return 0;
}
